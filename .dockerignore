# 运行时数据：账本/缓存/行情不进镜像（用 volume 挂载持久化）
data/
logs/
reports/

# 前端依赖与产物：node_modules 不进上下文；dist 由镜像内构建阶段生成
webui/node_modules/
webui/dist/
webui/.ui_verify/
webui/.ui_verify_open.txt

# Python 产物
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# 敏感配置：用 --env-file / volume 注入，不烘焙进镜像
config/.env
.env
.env.*

# 文档/临时/版本控制
docs/
tests/
.verify_tmp/
.workbuddy/
.git/
.gitignore
*.md
Dockerfile
docker-compose.yml
.dockerignore
